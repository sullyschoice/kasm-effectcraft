FROM kasmweb/core-ubuntu-noble:1.19.0-rolling-daily
USER root

ENV HOME=/home/kasm-default-profile
ENV STARTUPDIR=/dockerstartup
ENV INST_SCRIPTS=$STARTUPDIR/install
WORKDIR $HOME

######### Customize Container Here ###########

# Leave empty to install the latest release, or pass e.g. --build-arg EFFECTCRAFT_VERSION=0.9.2
ARG EFFECTCRAFT_VERSION=""

COPY ./src/effectcraft $INST_SCRIPTS/effectcraft/
RUN EFFECTCRAFT_VERSION=${EFFECTCRAFT_VERSION} bash $INST_SCRIPTS/effectcraft/install_effectcraft.sh && rm -rf $INST_SCRIPTS/effectcraft/

COPY ./src/effectcraft/custom_startup.sh $STARTUPDIR/custom_startup.sh
RUN chmod +x $STARTUPDIR/custom_startup.sh

######### End Customizations ###########

RUN chown 1000:0 $HOME
RUN $STARTUPDIR/set_user_permission.sh $HOME

ENV HOME=/home/kasm-user
WORKDIR $HOME
RUN mkdir -p $HOME && chown -R 1000:0 $HOME

USER 1000
